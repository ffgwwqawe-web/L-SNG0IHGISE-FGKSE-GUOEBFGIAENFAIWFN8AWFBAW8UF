        ScreenPos = Vector2.new(vp.X, vp.Y)
        OnScreen = vis == true
    end

    local ShowFov  = S.FieldOfView.Draw == true
    local ShowLine = (S.FieldOfView.DrawSnapline == true) and ScreenPos ~= nil and OnScreen == true

    if HAS_DRAWING and FieldOfView and FieldOfView.Visible ~= nil then
        -- jalur Drawing asli
        if FovUI then
            pcall(function() FovUI.circle.Visible = false; FovUI.line.Visible = false end)
        end
        FieldOfView.Position = ClientPosition
        FieldOfView.Radius = Radius
        FieldOfView.Color = VIS.FovColor
        FieldOfView.Transparency = VIS.FovTransparency
        FieldOfView.Thickness = VIS.FovThickness
        FieldOfView.Visible = ShowFov
        if FieldOfViewFill then
            FieldOfViewFill.Position = ClientPosition
            FieldOfViewFill.Radius = Radius
            FieldOfViewFill.Color = VIS.FovFilledColor
            FieldOfViewFill.Transparency = math.clamp(1 - VIS.FovFilledTransparency, 0, 1)
            FieldOfViewFill.Visible = ShowFov and VIS.FovFilled
        end
        if Snapline then
            Snapline.Color = VIS.SnaplineColor
            Snapline.Thickness = VIS.SnaplineThickness
            Snapline.Transparency = VIS.SnaplineTransparency
            if ShowLine then
                Snapline.From = ClientPosition
                Snapline.To = ScreenPos
            end
            Snapline.Visible = ShowLine
        end
    else
        -- jalur GUI: sama persis dengan street life.lua (garis di tengah)
        pcall(function()
            local Fv = EnsureFovUI()
            if not Fv then return end
            if ShowFov then
                Fv.circle.Visible = true
                Fv.circle.Size = UDim2.fromOffset(Radius * 2, Radius * 2)
                Fv.circle.Position = UDim2.fromOffset(ClientPosition.X, ClientPosition.Y)
                Fv.stroke.Color = VIS.FovColor
                Fv.stroke.Thickness = VIS.FovThickness
                Fv.stroke.Transparency = VIS.FovTransparency
                Fv.fill.Visible = VIS.FovFilled
                Fv.fill.BackgroundColor3 = VIS.FovFilledColor
                Fv.fill.BackgroundTransparency = VIS.FovFilledTransparency
            else
                Fv.circle.Visible = false
                Fv.fill.Visible = false
            end
            if ShowLine then
                local dx, dy = ScreenPos.X - ClientPosition.X, ScreenPos.Y - ClientPosition.Y
                local len = math.max((dx * dx + dy * dy) ^ 0.5, 1)
                local midX, midY = (ClientPosition.X + ScreenPos.X) / 2, (ClientPosition.Y + ScreenPos.Y) / 2
                Fv.line.Visible = true
                Fv.line.Position = UDim2.fromOffset(midX, midY)
                Fv.line.Size = UDim2.fromOffset(len, math.max(VIS.SnaplineThickness, 1))
                Fv.line.Rotation = math.deg(math.atan2(dy, dx))
                Fv.line.BackgroundColor3 = VIS.SnaplineColor
                Fv.line.BackgroundTransparency = VIS.SnaplineTransparency
            else
                Fv.line.Visible = false
            end
        end)
    end

    if Target_Highlight then
        if S.FieldOfView.HightlightTarget and TargetHead then
            Target_Highlight.Adornee = Target.Character
        else
            Target_Highlight.Adornee = nil
        end
