local GetSelectedTarget = LPH_NO_VIRTUALIZE(function()
    if Device_Mobile then
        S.TargetSelector.Targetting = S.Silent.Enabled
    end

    if not S.TargetSelector.Targetting then
        Target = nil
        return nil
    end

    local PlayersList = Players:GetPlayers()
    local MouseLocation = getAimOrigin()
    local Radius = S.TargetSelector.UseFOV and S.FieldOfView.Radius or math.huge

    local ClosestPlayer = nil
    local ClosestDistance = math.huge

    for _, Plr in ipairs(PlayersList) do
        if Plr == Player then continue end
        if S.whitelist[Plr.Name] then continue end

        local Character = Plr.Character
        if not Character then continue end

        local Humanoid = Character:FindFirstChild("Humanoid")
        local Head = Character:FindFirstChild("Head")

        if not Humanoid or not Head then continue end

        local ScreenPos, OnScreen = Camera:WorldToScreenPoint(Head.Position)
        if not OnScreen then continue end

        local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MouseLocation).Magnitude
        if Distance > Radius then continue end

        local IsVisible = true
        if S.TargetSelector.VisibleCheck and not S.Silent.WallBang then
            IsVisible = WallCheck(Character)
            if not IsVisible then continue end
        end

        if S.TargetSelector.HealthCheck and Humanoid.Health < S.TargetSelector.Health then continue end
        if S.TargetSelector.FriendCheck and table.find(Friends, Plr.Name) then continue end
        if S.TargetSelector.LimitDistance and not DistanceCheck(Plr, S.TargetSelector.MaxDistance) then continue end
        if S.TargetSelector.ProtectedCheck and S.InsideSafezone(Plr) then continue end

        if Distance < ClosestDistance then
            ClosestDistance = Distance
            ClosestPlayer = Plr
        end
    end

    Target = ClosestPlayer
    return Target
end)

local game_metatable = getrawmetatable(game)

setreadonly(game_metatable, false)

local __index_hook = game_metatable.__index;
local __namecall_hook = game_metatable.__namecall

game_metatable.__index = LPH_NO_VIRTUALIZE(function(Self, Index)
    if Index == "Size" or Index == "CanCollide" then
        if typeof(Self) == "Instance" and Self.Name then
            if Self.Name == "Head" and Index == "Size" then
                return Vector3.new(1.1542654037475586, 1.1710413694381714, 1.1542654037475586)
            end

            if Player_Collide_Data[Self.Name] and Index == "CanCollide" then
                return Player_Collide_Data[Self.Name]
            end
        end
    end

    return __index_hook(Self, Index)
end)

game_metatable.__namecall = LPH_NO_VIRTUALIZE(function(Self, ...)
    local Arguments = {...}
    local Method = getnamecallmethod()

    if Method == "Raycast" and S.Silent.Enabled then
        if checkcaller() then
            return __namecall_hook(Self, ...)
        end

        local Script = getcallingscript()

        if Script and Script.Name:find("?") then
            return __namecall_hook(Self, ...)
        end

        local Traceback = debug.traceback()

        if Traceback:find("Move") then
            return __namecall_hook(Self, ...)
        end

        if Traceback:find("MouseHover") then
            return __namecall_hook(Self, ...)
        end

        if Traceback:find("isWallInFront") then
            return __namecall_hook(Self, ...)
        end

        if S.TargetSelector.Targetting then
            if not (math.random(0, 100) <= S.Silent.HitChance) then
                return __namecall_hook(Self, ...)
            end

            local TargetPart;

            if Target and Target.Character then
                TargetPart = FindFirstChild(Target.Character, S.Silent.HitParts[1] and S.Silent.HitParts[math.random(1, #S.Silent.HitParts)] or "Head")

                if not TargetPart then
                    return __namecall_hook(Self, ...)
                end

                local Origin = Arguments[1];
                local Direction = (TargetPart.Position - Origin).Unit * 1000;

                --task.spawn(S.MakeTracer, TargetPart.Position)
                --task.spawn(S.PlaySound);
                Arguments[2] = Direction;
            end;

            if S.Silent.WallBang and Target and Target.Character and TargetPart then
                --task.spawn(S.MakeTracer, TargetPart.Position)
                --task.spawn(S.PlaySound);

                return {
                    Instance = TargetPart;
                    Position = TargetPart.Position;
                    Distance = (TargetPart.Position - Arguments[1]).Magnitude;
                    Material = Enum.Material.SmoothPlastic;
                    Normal = Vector3.zero;
                }
            end;

            return __namecall_hook(Self, unpack(Arguments))
        end;
    end;

    return __namecall_hook(Self, ...)
end)

