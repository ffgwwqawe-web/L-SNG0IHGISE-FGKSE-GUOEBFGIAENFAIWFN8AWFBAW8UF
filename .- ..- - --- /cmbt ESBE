local function MakeKeyPicker(Section, Data)
    local BoundKey = Data.Default or Data.Key
    local Mode = Data.Mode or "Toggle"
    local Active = false
    local Callback = Data.Callback or function() end

    local Keybind = Section:Keybind({
        Name = Data.Text or Data.Name or "Keybind",
        Default = BoundKey,
        Flag = Data.Flag,
        Callback = function() end
    })

    local OrigSet = Keybind.Set
    Keybind.Set = function(Self2, NewKey)
        BoundKey = NewKey
        return OrigSet(Self2, NewKey)
    end

    local function Match(Input, Key)
        local Selected = Input.UserInputType == Enum.UserInputType.Keyboard and Input.KeyCode or Input.UserInputType
        return Selected == Key or tostring(Selected) == tostring(Key)
    end

    Zolar:Connect(UserInputService.InputBegan, function(Input, Processed)
        if Processed then
            return
        end

        if not Match(Input, BoundKey) then
            return
        end

        if Mode == "Toggle" then
            Active = not Active
            pcall(Callback, Active)
        elseif Mode == "Hold" then
            pcall(Callback, true)
        else
            Active = true
        end
    end)

    Zolar:Connect(UserInputService.InputEnded, function(Input, Processed)
        if Processed then
            return
        end

        if not Match(Input, BoundKey) then
            return
        end

        if Mode == "Hold" then
            pcall(Callback, false)
        end
    end)

    return Keybind
end

local function AttachSection(Section)
    Section.AddToggle = function(Self, Data)
        Data = Data or {}

        return Section:Toggle({
            Name = Data.Text or Data.Name or "Toggle",
            Flag = Data.Flag,
            Default = Data.Default,
            Callback = Data.Callback
        })
    end

    Section.AddSlider = function(Self, Data)
        Data = Data or {}

        return Section:Slider({
            Name = Data.Text or Data.Name or "Slider",
            Flag = Data.Flag,
            Min = Data.Min,
            Max = Data.Max,
            Default = Data.Default,
            Suffix = Data.Suffix or "",
            Decimals = Data.Decimal and (10 ^ -Data.Decimal) or 1,
            Callback = Data.Callback
        })
    end

    Section.AddDropdown = function(Self, Data)
        Data = Data or {}

        local Dropdown = Section:Dropdown({
            Name = Data.Text or Data.Name or "Dropdown",
            Flag = Data.Flag,
            Items = Data.Options or Data.Items or {},
            Default = Data.Default,
            Multi = Data.Multi,
            Callback = Data.Callback
        })

        Dropdown.RefreshOptions = function(Self2, List)
            return Dropdown:Refresh(List or {})
        end

        return Dropdown
    end

    Section.AddColorPicker = function(Self, Data)
        Data = Data or {}

        local Alpha = Data.Alpha
        if Alpha == nil then
            Alpha = Data.Transparency or 0
        end

        local Picker = Section:Colorpicker({
            Name = Data.Text or Data.Name or "Color",
            Flag = Data.Flag,
            Default = Data.Default or Data.Color,
            Transparency = Alpha,
            Callback = Data.Callback
        })

        if Data.Callback then
            pcall(Data.Callback, Data.Default or Data.Color or Color3.new(1, 1, 1), Alpha)
        end

        return Picker
    end

    Section.AddLabel = function(Self, Data)
        Data = Data or {}

        local Label = Section:Label({ Name = Data.Text or Data.Name or "Label" })

        Label.ChangeText = function(Self2, Text)
            return Label:Set(Text)
        end

        return Label
    end

    Section.AddButton = function(Self, Data)
        Data = Data or {}

        return Section:Button({
            Name = Data.Text or Data.Name or "Button",
            Callback = Data.Callback
        })
    end

    Section.AddInput = function(Self, Data)
        Data = Data or {}

        return Section:Textbox({
            Name = Data.Text or Data.Name or "Input",
            Flag = Data.Flag,
            Default = Data.Default,
            Placeholder = Data.PlaceHolder or Data.Placeholder or "type here...",
            Callback = Data.Callback
        })
    end

    Section.AddKeyPicker = function(Self, Data)
        Data = Data or {}
        return MakeKeyPicker(Section, Data)
    end

    return Section
end

function FunctionLibrary.CreateWindow(Self, Data)
    Data = Data or {}

    local ZWindow = Zolar:Window({
        Name = Data.Title or "NovaExploit.SCRIPT",
        Icon = Data.Image or "layers",
        Accent = Color3.fromRGB(179, 165, 255)
    })

    local Window = { _zw = ZWindow, Visible = true }

    local OrigSetOpen = ZWindow.SetOpen
    ZWindow.SetOpen = function(Self2, Bool)
        Window.Visible = Bool and true or false
        return OrigSetOpen(Self2, Bool)
    end

    function Window.SetVisible(Self2, Bool)
        Window.Visible = Bool and true or false
        return ZWindow:SetOpen(Window.Visible)
    end

    function Window.AddTab(Self2, Data2)
        Data2 = Data2 or {}

        local Icon = Data2.Icon or "circle"
        local ZTab = ZWindow:Tab({
            Name = Data2.Text or Data2.Title or "Tab",
            Icon = Icon
        })

        local Names = Data2.Pages or { "Page" }
        local Pages = {}

        for Index = 1, #Names do
            local ZSub = ZTab:SubTab({
                Name = Names[Index],
                Icon = Icon
            })

            local Page = {}
            function Page.AddSection(Self3, SData)
                SData = SData or {}

                return AttachSection(ZSub:Section({
                    Name = SData.Title or SData.Text or "Section",
                    Side = SData.Side or "Left"
                }))
            end

            Pages[Index] = Page
        end

        return table.unpack(Pages)
    end

    return Window
end

