        local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = typeof(pos) == "Vector3" and CFrame.new(pos) or pos })
        tween:Play(); tween.Completed:Wait()
