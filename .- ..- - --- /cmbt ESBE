local DistanceCheck = LPH_NO_VIRTUALIZE(function(CheckedPlayer, Distance)
    if not CheckedPlayer then
        return false
    end

    if not CheckedPlayer.Character or not Player.Character then
        return false
    end

    local TargetRootPart, LocalRootPart = CheckedPlayer.Character:FindFirstChild("HumanoidRootPart"), Player.Character:FindFirstChild("HumanoidRootPart")

    if CheckedPlayer.Character and Player.Character and LocalRootPart and TargetRootPart then
        local Magnitude = (LocalRootPart.Position - TargetRootPart.Position).Magnitude;

        return Distance > Magnitude
    end;

    return false
end);

